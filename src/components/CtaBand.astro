---
import { waLink } from '../data/site';
import WhatsAppIcon from './WhatsAppIcon.astro';
interface Props { title?: string; text?: string; message?: string }
const {
  title = '¿Listo para dar el siguiente paso?',
  text = 'Escríbenos y un asesor te orientará sobre el programa ideal para ti, tus hijos o tu institución.',
  message,
} = Astro.props;
---
<section class="pb-20">
  <div class="container-x">
    <div class="hex-pattern relative overflow-hidden rounded-[2rem] bg-brand px-6 py-12 text-white sm:px-12 md:flex md:items-center md:justify-between md:gap-10">
      <div class="max-w-xl">
        <h2 class="text-3xl font-semibold text-white">{title}</h2>
        <p class="mt-3 text-white/85">{text}</p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3 md:mt-0 md:shrink-0">
        <a href={waLink(message)} target="_blank" rel="noopener" class="btn bg-white text-navy hover:bg-sky-50"><WhatsAppIcon /> WhatsApp</a>
        <a href="/contacto" class="btn btn-ghost">Formulario de contacto</a>
      </div>
    </div>
  </div>
</section>
