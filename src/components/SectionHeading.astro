---
interface Props { eyebrow?: string; title: string; text?: string; center?: boolean; light?: boolean }
const { eyebrow, title, text, center = false, light = false } = Astro.props;
---
<div class:list={['max-w-2xl', center && 'mx-auto text-center']}>
  {eyebrow && <p class:list={['eyebrow', light && 'text-sky']}>{eyebrow}</p>}
  <h2 class:list={['mt-3 text-3xl font-semibold sm:text-4xl', light && 'text-white']}>{title}</h2>
  {text && <p class:list={['mt-4 text-lg', light ? 'text-white/75' : 'text-muted']}>{text}</p>}
</div>
