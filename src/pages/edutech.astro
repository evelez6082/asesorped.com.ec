---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import ElizeWordmark from '../components/ElizeWordmark.astro';
import { waLink } from '../data/site';
import { elize, elizeModules, edutechServices } from '../data/elize';

const steps = [
  ['Diagnóstico', 'Entendemos sus procesos y definimos prioridades.'],
  ['Puesta en marcha', 'Configuramos elize. La plataforma queda operativa en 24 horas.'],
  ['Capacitación', 'Formamos a cada rol con Elize Academy.'],
  ['Acompañamiento', 'Seguimiento continuo y soporte 24/7 con Elizio.'],
];
---
<Base
  title="Asesoría EduTech"
  description="Asesoría en tecnología educativa de ASESORPED S.A., en alianza con elize: diagnóstico, implementación del ERP educativo, capacitación y acompañamiento para instituciones educativas."
>
  <!-- HERO con la firma visual de elize -->
  <section class="elize-gradient text-black">
    <div class="container-x py-16 md:py-24">
      <nav aria-label="Ruta" class="text-sm text-black/60">
        <a href="/" class="hover:text-black">Inicio</a> / <a href="/asesoria" class="hover:text-black">Asesoría</a> / <span class="text-black">EduTech</span>
      </nav>
      <p class="mt-6 font-display text-xs font-semibold tracking-[0.18em] uppercase">Asesoría EduTech · en alianza con elize</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold text-black sm:text-5xl">La gestión deja de ser reactiva. Se convierte en estratégica.</h1>
      <p class="mt-6 max-w-2xl text-lg text-black/80">
        Unimos la experiencia pedagógica de ASESORPED con la tecnología de elize, el ERP educativo inteligente, para que su institución gane orden, control y decisiones basadas en datos.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={waLink(elize.waMessage)} target="_blank" rel="noopener" class="btn bg-black text-white hover:bg-black/80"><WhatsAppIcon /> Agendar una demostración</a>
        <a href={elize.url} target="_blank" rel="noopener" class="btn border border-black/30 text-black hover:bg-black/10">Conocer elize</a>
      </div>
    </div>
  </section>

  <!-- POR QUÉ -->
  <section class="bg-elize-cream py-20">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow text-elize-orange-ink">Por qué una asesoría</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">No se trata de instalar un sistema. Se trata de profesionalizar la gestión.</h2>
      </div>
      <div class="prose-x text-lg text-ink/80">
        <p>Muchas instituciones compran software que nadie termina de usar. La diferencia está en el acompañamiento: entender los procesos, configurar con criterio pedagógico y formar a las personas.</p>
        <p>ASESORPED conoce el sistema educativo ecuatoriano desde adentro. elize aporta una plataforma diseñada para la gestión académica, administrativa y financiera, con arquitectura de seguridad alineada a ISO/IEC 27001.</p>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="py-20">
    <div class="container-x">
      <SectionHeading eyebrow="Servicios" title="Qué incluye la Asesoría EduTech" />
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {edutechServices.map((s) => (
          <article class="card p-8">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-elize-orange/15 text-elize-orange-ink"><Icon name={s.icon} /></span>
            <h3 class="mt-5 text-xl font-semibold">{s.title}</h3>
            <p class="mt-3 text-muted">{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- MÓDULOS (bento) -->
  <section class="bg-black py-20 text-white">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="font-display text-xs font-semibold tracking-[0.18em] text-elize-orange uppercase">La plataforma</p>
          <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Todo en un solo sistema: <span class="text-elize-orange"><ElizeWordmark onColor class="inline h-9 w-auto align-baseline" /></span></h2>
        </div>
        <p class="max-w-sm text-white/70">{elize.tagline}. Mayor control. Menos carga operativa.</p>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-6">
        {elizeModules.map((m, i) => (
          <article class:list={['rounded-3xl p-7', i === 0 && 'bg-elize-orange text-black md:col-span-3', i === 1 && 'bg-elize-olive text-black md:col-span-3', i > 1 && 'border border-white/15 bg-white/5 md:col-span-3']}>
            <p class:list={['text-xs font-semibold tracking-[0.16em] uppercase', i > 1 ? 'text-white/60' : 'text-black/70']}>{m.kicker}</p>
            <h3 class:list={['mt-2 text-2xl font-semibold', i > 1 ? 'text-white' : 'text-black']}>{m.name}</h3>
            <ul class="mt-5 space-y-2">
              {m.items.map((it) => (
                <li class="flex gap-2"><Icon name="check" class="mt-1 h-4 w-4 shrink-0" /><span>{it}</span></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section class="py-20">
    <div class="container-x">
      <SectionHeading center eyebrow="Cómo trabajamos" title="De la decisión a la operación, sin fricción" />
      <ol class="mt-12 grid gap-6 md:grid-cols-4">
        {steps.map(([t, d], i) => (
          <li class="card">
            <span class="font-display text-4xl font-bold text-elize-orange-ink">0{i + 1}</span>
            <h3 class="mt-3 text-lg font-semibold">{t}</h3>
            <p class="mt-2 text-muted">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <section class="pb-20">
    <div class="container-x">
      <div class="elize-gradient rounded-[2rem] px-6 py-12 text-black sm:px-12 md:flex md:items-center md:justify-between md:gap-10">
        <div class="max-w-xl">
          <h2 class="text-3xl font-semibold text-black">El futuro de su institución se gestiona con inteligencia.</h2>
          <p class="mt-3 text-black/80">Agende una demostración y un asesor le mostrará elize con los procesos de su institución.</p>
        </div>
        <a href={waLink(elize.waMessage)} target="_blank" rel="noopener" class="btn mt-8 bg-black text-white hover:bg-black/80 md:mt-0 md:shrink-0"><WhatsAppIcon /> Agendar demostración</a>
      </div>
    </div>
  </section>
</Base>
