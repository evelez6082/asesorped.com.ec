---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada">
  <section class="container-x py-28 text-center">
    <p class="font-display text-7xl font-bold text-sky">404</p>
    <h1 class="mt-4 text-3xl font-semibold">No encontramos esta página</h1>
    <p class="mt-3 text-muted">Es posible que el enlace haya cambiado.</p>
    <a href="/" class="btn btn-dark mt-8">Volver al inicio</a>
  </section>
</Base>
