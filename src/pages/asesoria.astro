---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import ElizeBand from '../components/ElizeBand.astro';
import Icon from '../components/Icon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { waLink } from '../data/site';

const services: { icon: string; title: string; text: string; items: string[]; href?: string }[] = [
  {
    icon: 'book',
    title: 'Asesoría académica',
    text: 'Acompañamos a unidades educativas y centros de capacitación en planificación curricular, modelos pedagógicos, evaluación y mejora continua.',
    items: ['Planificación y portafolio docente', 'Modelos pedagógicos y andragógicos', 'Evaluación y seguimiento del aprendizaje'],
  },
  {
    icon: 'scale',
    title: 'Asesoría legal educativa',
    text: 'Orientación en procesos y normativa del sector educativo para que tu institución opere con tranquilidad.',
    items: ['Procesos ante la autoridad educativa', 'Normativa y reglamentos internos', 'Representación en procedimientos administrativos'],
  },
  {
    icon: 'users',
    title: 'Formación docente',
    text: 'Programas para fortalecer el perfil de tus docentes y capacitadores, en modalidad virtual o presencial.',
    items: ['Formación de Formadores (20 h)', 'Didáctica, pedagogía y andragogía', 'Certificación para los participantes'],
  },
  {
    icon: 'target',
    title: 'Talleres para equipos',
    text: 'Talleres vivenciales de liderazgo y motivación para instituciones, empresas y organizaciones.',
    items: ['Liderazgo y motivación en la gestión del cambio', 'Comunicación asertiva y adaptabilidad', 'Dinámicas y perfiles de liderazgo'],
  },
];

services.push({
  icon: 'screen',
  title: 'Asesoría EduTech',
  text: 'Transformación digital de la gestión académica, administrativa y financiera, en alianza con elize, el ERP educativo inteligente.',
  items: ['Diagnóstico de madurez digital', 'Implementación de elize', 'Capacitación y acompañamiento'],
  href: '/edutech',
});

const steps = [
  ['Diagnóstico', 'Conversamos con tu equipo directivo para entender necesidades y objetivos.'],
  ['Propuesta', 'Diseñamos un plan de trabajo a la medida de tu institución.'],
  ['Acompañamiento', 'Ejecutamos con tu equipo: asesoría, formación y seguimiento.'],
  ['Resultados', 'Medimos el avance y ajustamos para la mejora continua.'],
];
---
<Base title="Asesoría a instituciones" description="Asesoría académica y legal, formación docente y talleres de liderazgo para instituciones educativas y organizaciones en Ecuador.">
  <section class="hex-pattern bg-navy text-white">
    <div class="container-x grid items-center gap-10 py-16 md:py-20 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="eyebrow text-sky">Para instituciones y organizaciones</p>
        <h1 class="mt-3 text-4xl font-bold text-white sm:text-5xl">Asesoramiento pedagógico que fortalece a tu institución</h1>
        <p class="mt-6 max-w-xl text-lg text-white/80">Somos un centro de asesoramiento pedagógico con más de una década acompañando a unidades educativas y centros de capacitación, y con experiencia propia dirigiendo instituciones.</p>
        <a href={waLink('Hola, represento a una institución y quiero información sobre la asesoría de ASESORPED.')} target="_blank" rel="noopener" class="btn btn-primary mt-8"><WhatsAppIcon /> Agendar una reunión</a>
      </div>
      <img src="/img/isotipo.png" alt="" class="mx-auto hidden w-64 rounded-[2rem] bg-white p-8 lg:block" />
    </div>
  </section>

  <section class="py-20">
    <div class="container-x">
      <SectionHeading eyebrow="Servicios" title="Lo que hacemos por tu institución" />
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {services.map((s) => (
          <article class="card p-8">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-sky-100 text-brand"><Icon name={s.icon} /></span>
            <h2 class="mt-5 text-2xl font-semibold">{s.title}</h2>
            <p class="mt-3 text-muted">{s.text}</p>
            <ul class="mt-5 space-y-2">
              {s.items.map((i) => <li class="flex gap-2"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-accent" /><span>{i}</span></li>)}
            </ul>
            {s.href && <a href={s.href} class="mt-6 inline-flex items-center gap-2 font-display text-sm font-semibold text-brand hover:text-navy">Ver Asesoría EduTech <Icon name="arrow" class="h-4 w-4" /></a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-paper py-20">
    <div class="container-x">
      <SectionHeading center eyebrow="Cómo trabajamos" title="Un proceso claro, de principio a fin" />
      <ol class="mt-12 grid gap-6 md:grid-cols-4">
        {steps.map(([t, d], i) => (
          <li class="card">
            <span class="font-display text-4xl font-bold text-accent">0{i + 1}</span>
            <h3 class="mt-3 text-lg font-semibold">{t}</h3>
            <p class="mt-2 text-muted">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-20">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div>
        <SectionHeading eyebrow="Experiencia que respalda" title="Conocemos el sistema educativo desde adentro" />
        <p class="mt-6 text-lg text-muted">Nuestro equipo incluye ex autoridades zonales y distritales de educación, rectores y vicerrectores en ejercicio, docentes universitarios y formadores de formadores. Además, dirigimos nuestras propias unidades educativas: aplicamos en casa lo que recomendamos.</p>
        <a href="/nosotros" class="btn btn-outline mt-8">Conoce al equipo</a>
      </div>
      <img src="/img/equipo.jpg" alt="Equipo de trabajo en una sesión de asesoría" width="1600" height="1068" loading="lazy" class="aspect-[4/3] w-full rounded-[2rem] object-cover shadow-xl" />
    </div>
  </section>

  <ElizeBand />

  <CtaBand title="Hablemos de tu institución" text="Cuéntanos qué necesitas y te proponemos un plan de trabajo." message="Hola, represento a una institución y quiero información sobre la asesoría de ASESORPED." />
</Base>
